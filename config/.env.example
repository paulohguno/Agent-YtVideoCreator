# Copie para config/.env (o instalar.sh faz isso) e preencha. Nunca commite o .env.

# Claude: nao precisa de chave. O sistema usa o Claude Code CLI (`claude -p`)
# com o seu login. Rode `claude` uma vez no terminal para entrar. DEC-17

# VoiceStudio local (clonagem da propria voz, tudo local). DEC-16
# O instalar.sh gera a chave e sobe o container em localhost:3900.
VOICESTUDIO_URL=http://localhost:3900
OMNIVOICE_API_KEY=

# Fontes de midia (DEC-18).
# Ja funcionam SEM chave: Wikimedia Commons, NASA, Openverse, Internet Archive,
# Library of Congress, The Met, Art Institute of Chicago, Cleveland Museum of Art.
# Opcionais, com chave gratuita (deixe vazio para desligar):
# https://www.pexels.com/api/
PEXELS_API_KEY=
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# https://pro.europeana.eu/page/get-api
EUROPEANA_API_KEY=
# https://api.data.gov/signup/
SMITHSONIAN_API_KEY=

# Caminho do navegador que a skill usa para capturar os quadros do video.
# Vazio = procura sozinho (google-chrome-stable, chromium...). So preencha se
# o navegador estiver num lugar fora do PATH.
CHROME_PATH=
